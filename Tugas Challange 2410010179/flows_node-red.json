    {
        "id": "func_cek_suhu_alarm",
        "type": "function",
        "z": "tab_challenge_2410010179",
        "name": "Cek Suhu > 35°C",
        "func": "let suhu = parseFloat(msg.payload);\nif (suhu > 35) {\n    return [\n        { payload: \"PERINGATAN! Suhu Melebihi 35°C (\" + suhu + \"°C)\", topic: \"ALARM SUHU TINGGI\" },\n        { payload: \"<font color='red'><b>BAHAYA: Suhu Tinggi (\" + suhu + \"°C)</b></font>\" }\n    ];\n} else {\n    return [\n        null,\n        { payload: \"<font color='green'>Normal (\" + suhu + \"°C)</font>\" }\n    ];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            [
                "ui_toast_alarm"
            ],
            [
                "ui_text_alarm_status"
            ]
        ]
